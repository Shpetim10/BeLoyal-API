<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changes/002-coupons.xml">

    <changeSet id="001-business-currency-code" author="shaba">
        <addColumn tableName="business">
            <column name="currency_code" type="VARCHAR(20)" defaultValue="EURO">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="002-loyalty-coupons" author="shaba">
        <createTable tableName="loyalty_coupons">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="business_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="image_url" type="VARCHAR(500)"/>
            <column name="points_cost" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="visibility" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="total_redemption_limit" type="INT"/>
            <column defaultValueNumeric="0" name="total_redemptions" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="per_customer_redemption_limit" type="INT"/>
            <column name="terms_and_conditions" type="VARCHAR(2000)"/>
            <column defaultValueBoolean="false" name="is_featured" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT"/>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
            <column name="archived_at" type="datetime(6)"/>
            <column name="deleted_at" type="datetime(6)"/>
        </createTable>
        <createIndex tableName="loyalty_coupons" indexName="idx_loyalty_coupons_business_id">
            <column name="business_id"/>
        </createIndex>
        <createIndex tableName="loyalty_coupons" indexName="idx_loyalty_coupons_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-coupon-free-product-details" author="shaba">
        <createTable tableName="coupon_free_product_details">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="coupon_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="variant_id" type="BIGINT"/>
            <column defaultValueNumeric="1" name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-coupon-discount-details" author="shaba">
        <createTable tableName="coupon_discount_details">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="coupon_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="discount_percentage" type="DECIMAL(5,2)"/>
            <column name="discount_amount" type="DECIMAL(12,2)"/>
            <column name="minimum_order_amount" type="DECIMAL(12,2)"/>
            <column name="maximum_discount_amount" type="DECIMAL(12,2)"/>
        </createTable>
    </changeSet>

    <changeSet id="005-customer-coupons" author="shaba">
        <createTable tableName="customer_coupons">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="coupon_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="business_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="customer_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="redeemed_at" type="datetime(6)"/>
            <column name="used_at" type="datetime(6)"/>
            <column name="expires_at" type="datetime(6)"/>
            <column name="order_id" type="VARCHAR(100)"/>
            <column name="points_spent" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="snapshot_title" type="VARCHAR(200)"/>
            <column name="snapshot_description" type="VARCHAR(1000)"/>
            <column name="snapshot_image_url" type="VARCHAR(500)"/>
            <column name="snapshot_coupon_type" type="VARCHAR(30)"/>
            <column name="snapshot_product_id" type="BIGINT"/>
            <column name="snapshot_variant_id" type="BIGINT"/>
            <column name="snapshot_discount_percentage" type="DECIMAL(5,2)"/>
            <column name="snapshot_discount_amount" type="DECIMAL(12,2)"/>
            <column name="snapshot_minimum_order_amount" type="DECIMAL(12,2)"/>
            <column name="snapshot_maximum_discount_amount" type="DECIMAL(12,2)"/>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
        </createTable>
        <createIndex tableName="customer_coupons" indexName="idx_customer_coupons_coupon_id">
            <column name="coupon_id"/>
        </createIndex>
        <createIndex tableName="customer_coupons" indexName="idx_customer_coupons_customer_profile_id">
            <column name="customer_profile_id"/>
        </createIndex>
        <createIndex tableName="customer_coupons" indexName="idx_customer_coupons_business_id">
            <column name="business_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
