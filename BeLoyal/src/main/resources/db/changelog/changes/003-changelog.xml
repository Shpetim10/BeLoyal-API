    <changeSet id="1775343644154-resolve-duplicates" author="shaba">
        <sql>
            UPDATE bill_transactions SET idempotency_key = CONCAT(idempotency_key, '-recovered-', id)
            WHERE id IN (
                SELECT id FROM (
                    SELECT id, ROW_NUMBER() OVER (PARTITION BY business_id, idempotency_key ORDER BY id) as rn
                    FROM bill_transactions
                    WHERE idempotency_key IS NOT NULL AND idempotency_key != ''
                ) t WHERE rn > 1
            );
            UPDATE bill_transactions SET idempotency_key = CONCAT('RECOVERED-EMPTY-', id)
            WHERE idempotency_key IS NULL OR idempotency_key = '';
        </sql>
    </changeSet>
