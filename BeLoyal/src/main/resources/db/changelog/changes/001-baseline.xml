<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changes/001-baseline.xml">

    <changeSet id="001-business" author="shaba">
        <createTable tableName="business">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="address" type="VARCHAR(255)"/>
            <column name="business_description" type="VARCHAR(1000)"/>
            <column name="business_email" type="VARCHAR(255)"/>
            <column name="business_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="business_phone_number" type="VARCHAR(255)"/>
            <column defaultValue="ACTIVE" name="business_status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column defaultValue="RESTAURANT" name="business_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="VARCHAR(255)"/>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="logo_key" type="VARCHAR(255)"/>
            <column name="logo_path" type="VARCHAR(255)"/>
            <column name="rating" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="rejection_reason" type="VARCHAR(2000)"/>
            <column name="reviewed_at" type="datetime(6)"/>
            <column name="reviewed_by_admin_id" type="BIGINT"/>
            <column name="submitted_at" type="datetime(6)"/>
            <column name="updated_at" type="datetime(6)"/>
            <column name="vat_id" type="VARCHAR(60)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="website_url" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-users" author="shaba">
        <createTable tableName="users">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="accepted_tc_at" type="datetime(6)"/>
            <column name="accepted_tc_version" type="VARCHAR(50)"/>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column defaultValueBoolean="false" name="email_verified" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="email_verified_at" type="datetime(6)"/>
            <column defaultValueNumeric="0" name="failed_login_attempts" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_login_at" type="datetime(6)"/>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="locked_until" type="datetime(6)"/>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="VARCHAR(30)">
                <constraints unique="true"/>
            </column>
            <column name="profile_image_key" type="VARCHAR(255)"/>
            <column name="profile_image_url" type="VARCHAR(255)"/>
            <column defaultValue="ENABLED" name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-business-members" author="shaba">
        <createTable tableName="business_members">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="hired_at" type="date"/>
            <column defaultValue="ACTIVE" name="member_status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column defaultValue="STAFF" name="role" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
            <column name="business_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-customer-profiles" author="shaba">
        <createTable tableName="customer_profiles">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="birth_date" type="date"/>
            <column name="city" type="VARCHAR(255)"/>
            <column name="country" type="VARCHAR(255)"/>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="gender" type="VARCHAR(255)"/>
            <column defaultValueBoolean="true" name="notification_enabled" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="referral_code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="referred_by" type="VARCHAR(20)"/>
            <column name="updated_at" type="datetime(6)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="005-earning-settings" author="shaba">
        <createTable tableName="earning_settings">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="amount_per" type="DECIMAL(38, 2)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueBoolean="false" name="configured" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime(6)"/>
            <column defaultValueBoolean="false" name="enabled" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="points_per" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
            <column name="business_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="006-loyalty-accounts" author="shaba">
        <createTable tableName="loyalty_accounts">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="available_points" type="INT"/>
            <column name="created_at" type="datetime(6)"/>
            <column name="last_activity_at" type="datetime(6)"/>
            <column name="lifetime_earned" type="INT"/>
            <column name="lifetime_expired" type="INT"/>
            <column name="lifetime_redeemed" type="INT"/>
            <column name="updated_at" type="datetime(6)"/>
            <column name="business_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="customer_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="007-loyalty-cards" author="shaba">
        <createTable tableName="loyalty_cards">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime(6)"/>
            <column name="issued_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="last_used_at" type="datetime(6)"/>
            <column name="manual_code" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="qr_token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="TINYINT(3)"/>
            <column name="updated_at" type="datetime(6)"/>
            <column name="customer_profile_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="008-loyalty-settings" author="shaba">
        <createTable tableName="loyalty_settings">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime(6)"/>
            <column defaultValue="NO_EXPIRY" name="expiry_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="max_points_per_transaction" type="INT"/>
            <column name="max_points_to_redeem" type="INT"/>
            <column name="min_points_to_redeem" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="months_to_expire" type="INT"/>
            <column name="points_per_unit_discount" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
            <column name="business_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column defaultValueBoolean="false" name="configured" type="TINYINT(1)"/>
            <column defaultValueBoolean="false" name="enabled" type="TINYINT(1)"/>
        </createTable>
    </changeSet>

    <changeSet id="009-bill-transactions" author="shaba">
        <createTable tableName="bill_transactions">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="bill_amount" type="DECIMAL(38, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="discount_amount" type="DECIMAL(38, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_reference" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="net_amount" type="DECIMAL(38, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="VARCHAR(255)"/>
            <column name="updated_at" type="datetime(6)"/>
            <column name="business_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="business_member_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="idempotency_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="request_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="010-points-transactions" author="shaba">
        <createTable tableName="points_transactions">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="discount_amount" type="DECIMAL(38, 2)"/>
            <column name="money_amount" type="DECIMAL(38, 2)"/>
            <column name="points_delta" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(255)"/>
            <column name="rule_amount_per" type="DECIMAL(38, 2)"/>
            <column name="rule_points_per" type="INT"/>
            <column name="scan_method" type="VARCHAR(255)"/>
            <column defaultValue="EARN_BILL" name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
            <column name="version" type="BIGINT"/>
            <column name="bill_transaction_id" type="BIGINT"/>
            <column name="performed_by_member_id" type="BIGINT"/>
            <column name="loyalty_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="011-points-buckets" author="shaba">
        <createTable tableName="points_buckets">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime(6)"/>
            <column name="earned_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="datetime(6)"/>
            <column name="points_earned" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="points_remaining" type="INT">
                <constraints nullable="false"/>
            </column>
            <column defaultValue="ACTIVE" name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
            <column name="loyalty_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="source_transaction_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="012-points-bucket-consumption" author="shaba">
        <createTable tableName="points_bucket_consumption">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime(6)"/>
            <column name="points_used" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="points_bucket_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="points_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="013-refresh-tokens" author="shaba">
        <createTable tableName="refresh_tokens">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="device_id" type="VARCHAR(255)"/>
            <column name="expires_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="datetime(6)"/>
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_agent" type="VARCHAR(255)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="014-reset-password-token" author="shaba">
        <createTable tableName="reset_password_token">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_date" type="datetime(6)"/>
            <column name="expiry_date" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column defaultValueBoolean="false" name="used" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="015-staff-invite-tokens" author="shaba">
        <createTable tableName="staff_invite_tokens">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime(6)"/>
            <column name="expires_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueBoolean="false" name="is_existing_user" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column defaultValueBoolean="false" name="used" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="business_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="016-user-roles" author="shaba">
        <createTable tableName="user_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="017-verification-email-token" author="shaba">
        <createTable tableName="verification_email_token">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime(6)"/>
            <column name="expires_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column defaultValueBoolean="false" name="used" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="018-catalog-category" author="shaba">
        <createTable tableName="catalog_category">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="business_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(300)"/>
            <column name="order_index" type="INT"/>
            <column defaultValue="ACTIVE" name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
            <column defaultValueBoolean="false" name="is_deleted" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="019-catalog-item" author="shaba">
        <createTable tableName="catalog_item">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="business_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="price" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column defaultValue="PRODUCT" name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column defaultValue="EUR" name="currency_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="unit" type="VARCHAR(255)"/>
            <column defaultValue="ACTIVE" name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="VARCHAR(255)"/>
            <column name="image_key" type="VARCHAR(255)"/>
            <column name="order_index" type="INT"/>
            <column defaultValueBoolean="false" name="is_deleted" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
        </createTable>
    </changeSet>

    <changeSet id="020-catalog-item-variant" author="shaba">
        <createTable tableName="catalog_item_variant">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="catalog_item_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="price_override" type="DECIMAL(12, 2)"/>
            <column defaultValue="ACTIVE" name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="order_index" type="INT">
                <constraints nullable="false"/>
            </column>
            <column defaultValueBoolean="false" name="is_deleted" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime(6)"/>
        </createTable>
    </changeSet>

    <changeSet id="021-bill-transactions-business-idempotency" author="shaba">
        <addUniqueConstraint tableName="bill_transactions"
                             columnNames="business_id, idempotency_key"
                             constraintName="uk_bill_tx_business_idem"/>
    </changeSet>

    <changeSet id="022-business-members-user-business" author="shaba">
        <addUniqueConstraint tableName="business_members"
                             columnNames="user_id, business_id"
                             constraintName="uk_business_members_user_business"/>
    </changeSet>

    <changeSet id="023-loyalty-accounts-profile-business" author="shaba">
        <addUniqueConstraint tableName="loyalty_accounts"
                             columnNames="customer_profile_id, business_id"
                             constraintName="uk_loyalty_account_unique_profile_and_business"/>
    </changeSet>

    <changeSet id="024-points-bucket-consumption-unique" author="shaba">
        <addUniqueConstraint tableName="points_bucket_consumption"
                             columnNames="points_transaction_id, points_bucket_id"
                             constraintName="uk_points_bucket_consumption_points_transaction_points_bucket"/>
    </changeSet>

    <changeSet id="025-points-buckets-unique" author="shaba">
        <addUniqueConstraint tableName="points_buckets"
                             columnNames="loyalty_account_id, source_transaction_id"
                             constraintName="uk_points_buckets_loyalty_account_source_transaction"/>
    </changeSet>

    <changeSet id="026-catalog-category-unique-name" author="shaba">
        <addUniqueConstraint tableName="catalog_category"
                             columnNames="business_id, name"
                             constraintName="uk_business_category_name"/>
    </changeSet>

    <changeSet id="027-catalog-category-unique-order" author="shaba">
        <addUniqueConstraint tableName="catalog_category"
                             columnNames="business_id, order_index"
                             constraintName="uk_business_category_order_index"/>
    </changeSet>

    <changeSet id="028-catalog-item-unique-order" author="shaba">
        <addUniqueConstraint tableName="catalog_item"
                             columnNames="business_id, category_id, order_index"
                             constraintName="uk_category_order_index"/>
    </changeSet>

    <changeSet id="029-catalog-item-variant-unique-name" author="shaba">
        <addUniqueConstraint tableName="catalog_item_variant"
                             columnNames="catalog_item_id, name"
                             constraintName="uk_item_variant_name"/>
    </changeSet>

    <changeSet id="030-catalog-item-variant-unique-order" author="shaba">
        <addUniqueConstraint tableName="catalog_item_variant"
                             columnNames="catalog_item_id, order_index"
                             constraintName="uk_item_variant_order_index"/>
    </changeSet>

